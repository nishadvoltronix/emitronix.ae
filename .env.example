# Zoho CRM OAuth credentials for website form lead creation.
# Add real values only in server/deployment environment variables, never in Git.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Optional defaults used by lib/zoho.ts; verify the tenant's data center/module.
# OAuth uses /oauth/v2/token. CRM writes use /crm/v8/<module> (no version override).
# Selected service/location/details go in Description; no custom field override.
# Actual deployed credentials, tenant acceptance and delivery require live verification.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CRM_MODULE=Leads
ZOHO_LEAD_SOURCE=Website Contact Form

# Cookie consent admin and runtime storage.
COOKIE_ADMIN_PASSWORD=
COOKIE_ADMIN_TOKEN=
COOKIE_CONSENT_STORE_PATH=

# Website administration and protected local storage.
ADMIN_SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERS_PATH=
CAREERS_STORE_DIR=
INTERNAL_ORIGIN=

# Consent-gated analytics and marketing integrations.
NEXT_PUBLIC_GTM_ID=GTM-MSM8MPD6
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_COOKIE_ANALYTICS_SCRIPT_URLS=
NEXT_PUBLIC_COOKIE_MARKETING_SCRIPT_URLS=
NEXT_PUBLIC_COOKIE_FUNCTIONAL_SCRIPT_URLS=
NEXT_PUBLIC_COOKIE_PERFORMANCE_SCRIPT_URLS=
